generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "esm"
  runtime         = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model admission_decisions {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id              String          @db.Uuid
  namespace_id        String          @db.Uuid
  spec_hash           String
  agent_version_id    String?         @db.Uuid
  caller_principal_id String          @db.Uuid
  approved            Boolean
  rejection_reasons   Json            @default("[]")
  checks              Json            @default("{}")
  decided_at          DateTime        @default(now()) @db.Timestamptz(6)
  agent_versions      agent_versions? @relation(fields: [agent_version_id], references: [id], onUpdate: NoAction)
  principals          principals      @relation(fields: [caller_principal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  namespaces          namespaces      @relation(fields: [namespace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orgs                orgs            @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([caller_principal_id, spec_hash, decided_at(sort: Desc)], map: "admission_spec_hash_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model agent_version_mcp_servers {
  agent_version_id String         @db.Uuid
  mcp_server_id    String         @db.Uuid
  allowed_tools    String[]
  allow_sampling   Boolean        @default(false)
  agent_versions   agent_versions @relation(fields: [agent_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mcp_servers      mcp_servers    @relation(fields: [mcp_server_id], references: [id], onUpdate: NoAction)

  @@id([agent_version_id, mcp_server_id])
}

model agent_version_peers {
  agent_version_id String         @db.Uuid
  peer_id          String         @db.Uuid
  alias            String
  agent_versions   agent_versions @relation(fields: [agent_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  peers            peers          @relation(fields: [peer_id], references: [id], onUpdate: NoAction)

  @@id([agent_version_id, peer_id])
  @@unique([agent_version_id, alias], map: "agent_version_peers_alias_unique")
}

model agent_version_speech {
  agent_version_id   String           @db.Uuid
  speech_provider_id String           @db.Uuid
  speech_kind        speech_kind
  agent_versions     agent_versions   @relation(fields: [agent_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  speech_providers   speech_providers @relation(fields: [speech_provider_id], references: [id], onUpdate: NoAction)

  @@id([agent_version_id, speech_kind])
}

model agent_version_sub_agents {
  agent_version_id String         @db.Uuid
  namespace_id     String         @db.Uuid
  sub_agent_id     String         @db.Uuid
  alias            String
  agent_versions   agent_versions @relation(fields: [agent_version_id, namespace_id], references: [id, namespace_id], onDelete: Cascade, onUpdate: NoAction)
  agents           agents         @relation(fields: [sub_agent_id, namespace_id], references: [id, namespace_id], onUpdate: NoAction)

  @@id([agent_version_id, sub_agent_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model agent_version_tools {
  agent_version_id                                      String         @db.Uuid
  tool_id                                               String         @db.Uuid
  effects                                               effect_class[]
  cache_ttl_seconds                                     Int?
  cache_scope                                           String?
  idempotency_key_tpl                                   String?
  compensation_tool_id                                  String?        @db.Uuid
  agent_versions                                        agent_versions @relation(fields: [agent_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tools_agent_version_tools_compensation_tool_idTotools tools?         @relation("agent_version_tools_compensation_tool_idTotools", fields: [compensation_tool_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tools_agent_version_tools_tool_idTotools              tools          @relation("agent_version_tools_tool_idTotools", fields: [tool_id], references: [id], onUpdate: NoAction)

  @@id([agent_version_id, tool_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model agent_versions {
  id                                                             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id                                                       String?                     @db.Uuid
  org_id                                                         String                      @db.Uuid
  namespace_id                                                   String                      @db.Uuid
  lifetime                                                       agent_lifetime
  version                                                        Int?
  spec                                                           Json
  spec_hash                                                      String
  workload_identity_id                                           String                      @db.Uuid
  model_id                                                       String                      @db.Uuid
  prompt_version_id                                              String?                     @db.Uuid
  policy_version_id                                              String?                     @db.Uuid
  durability                                                     durability_tier             @default(strict)
  transport                                                      transport                   @default(sse)
  data_class                                                     data_class                  @default(internal)
  tenant_isolation                                               String                      @default("strict")
  max_steps                                                      Int?
  max_tokens                                                     BigInt?
  max_cost_micros                                                BigInt?
  step_timeout_ms                                                Int                         @default(30000)
  run_timeout_ms                                                 Int                         @default(1800000)
  max_retries                                                    Int                         @default(3) @db.SmallInt
  max_concurrent_runs                                            Int?
  on_saturation                                                  saturation_policy           @default(queue)
  overridable_fields                                             String[]                    @default([])
  created_by                                                     String?                     @db.Uuid
  created_at                                                     DateTime                    @default(now()) @db.Timestamptz(6)
  admission_decisions                                            admission_decisions[]
  agent_version_collections                                      agent_version_collections[]
  agent_version_mcp_servers                                      agent_version_mcp_servers[]
  agent_version_peers                                            agent_version_peers[]
  agent_version_skills                                           agent_version_skills[]
  agent_version_speech                                           agent_version_speech[]
  agent_version_sub_agents                                       agent_version_sub_agents[]
  agent_version_tools                                            agent_version_tools[]
  agents                                                         agents?                     @relation(fields: [agent_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  principals_agent_versions_created_byToprincipals               principals?                 @relation("agent_versions_created_byToprincipals", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  models                                                         models                      @relation(fields: [model_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  namespaces                                                     namespaces                  @relation(fields: [namespace_id], references: [id], onUpdate: NoAction)
  orgs                                                           orgs                        @relation(fields: [org_id], references: [id], onUpdate: NoAction)
  policy_versions                                                policy_versions?            @relation(fields: [policy_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prompt_versions                                                prompt_versions?            @relation(fields: [prompt_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  principals_agent_versions_workload_identity_idToprincipals     principals                  @relation("agent_versions_workload_identity_idToprincipals", fields: [workload_identity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deployments_deployments_agent_version_idToagent_versions       deployments[]               @relation("deployments_agent_version_idToagent_versions")
  deployments_deployments_shadow_from_version_idToagent_versions deployments[]               @relation("deployments_shadow_from_version_idToagent_versions")
  eval_runs                                                      eval_runs[]
  eval_runs_eval_runs_executed_version_idToagent_versions        eval_runs[]                 @relation("eval_runs_executed_version_idToagent_versions")
  feedback                                                       feedback[]
  runs                                                           runs[]
  triggers                                                       triggers[]

  @@unique([agent_id, version])
  @@unique([id, namespace_id])
  @@unique([org_id, spec_hash], map: "agent_versions_ephemeral_spec_hash_uq", where: raw("(lifetime = 'ephemeral'::agent_lifetime)"))
  @@index([org_id, spec_hash], map: "agent_versions_spec_hash_idx")
}

model agents {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id                   String                     @db.Uuid
  namespace_id             String                     @db.Uuid
  name                     String                     @db.Citext
  owner                    String
  description              String?
  expose_as_peer           Boolean                    @default(false)
  archived_at              DateTime?                  @db.Timestamptz(6)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  agent_version_sub_agents agent_version_sub_agents[]
  agent_versions           agent_versions[]
  namespaces               namespaces                 @relation(fields: [namespace_id], references: [id], onUpdate: NoAction)
  orgs                     orgs                       @relation(fields: [org_id], references: [id], onUpdate: NoAction)
  deployments              deployments[]
  memory_records           memory_records[]
  peers                    peers[]
  promotion_gates          promotion_gates[]
  threads                  threads[]
  triggers                 triggers[]

  @@unique([id, namespace_id])
  @@unique([namespace_id, name])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model artifacts {
  id                                                                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id                                                            String             @db.Uuid
  namespace_id                                                      String             @db.Uuid
  tenant_ref                                                        String
  thread_id                                                         String?            @db.Uuid
  produced_by_run_id                                                String?            @db.Uuid
  produced_by_step_id                                               String?            @db.Uuid
  content_hash                                                      String
  storage_uri                                                       String
  media_type                                                        String
  size_bytes                                                        BigInt
  encryption_key_ref                                                String
  version                                                           Int                @default(1)
  parent_artifact_id                                                String?            @db.Uuid
  retention_policy                                                  String?
  expires_at                                                        DateTime?          @db.Timestamptz(6)
  legal_hold                                                        Boolean            @default(false)
  state                                                             artifact_state     @default(live)
  deleted_at                                                        DateTime?          @db.Timestamptz(6)
  metadata                                                          Json               @default("{}")
  created_at                                                        DateTime           @default(now()) @db.Timestamptz(6)
  namespaces                                                        namespaces         @relation(fields: [namespace_id], references: [id], onUpdate: NoAction)
  orgs                                                              orgs               @relation(fields: [org_id], references: [id], onUpdate: NoAction)
  artifacts                                                         artifacts?         @relation("artifactsToartifacts", fields: [parent_artifact_id], references: [id], onUpdate: NoAction)
  other_artifacts                                                   artifacts[]        @relation("artifactsToartifacts")
  runs_artifacts_produced_by_run_idToruns                           runs?              @relation("artifacts_produced_by_run_idToruns", fields: [produced_by_run_id], references: [id], onUpdate: NoAction)
  steps_artifacts_produced_by_step_idTosteps                        steps?             @relation("artifacts_produced_by_step_idTosteps", fields: [produced_by_step_id], references: [id], onUpdate: NoAction)
  threads                                                           threads?           @relation(fields: [thread_id], references: [id], onUpdate: NoAction)
  checkpoints                                                       checkpoints[]
  memory_records                                                    memory_records[]
  runs_runs_input_artifact_idToartifacts                            runs[]             @relation("runs_input_artifact_idToartifacts")
  runs_runs_output_artifact_idToartifacts                           runs[]             @relation("runs_output_artifact_idToartifacts")
  steps_steps_input_artifact_idToartifacts                          steps[]            @relation("steps_input_artifact_idToartifacts")
  steps_steps_output_artifact_idToartifacts                         steps[]            @relation("steps_output_artifact_idToartifacts")
  tool_invocations_tool_invocations_request_artifact_idToartifacts  tool_invocations[] @relation("tool_invocations_request_artifact_idToartifacts")
  tool_invocations_tool_invocations_response_artifact_idToartifacts tool_invocations[] @relation("tool_invocations_response_artifact_idToartifacts")

  @@unique([org_id, namespace_id, tenant_ref, content_hash], map: "artifacts_tenant_content_hash_key")
  @@index([expires_at], map: "artifacts_gc_idx", where: raw("((state = 'live'::artifact_state) AND (legal_hold = false) AND (expires_at IS NOT NULL))"))
  @@index([thread_id, created_at(sort: Desc)], map: "artifacts_thread_idx")
  @@index([produced_by_run_id], map: "artifacts_run_idx", where: raw("(produced_by_run_id IS NOT NULL)"))
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_log {
  id                        String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurred_at               DateTime @default(now()) @db.Timestamptz(6)
  org_id                    String   @db.Uuid
  namespace_id              String?  @db.Uuid
  tenant_ref                String?
  actor_principal_id        String   @db.Uuid
  on_behalf_of_principal_id String?  @db.Uuid
  action                    String
  resource_kind             String
  resource_id               String?  @db.Uuid
  outcome                   String
  reason                    String?
  source_ip                 String?  @db.Inet
  detail                    Json     @default("{}")

  @@id([id, occurred_at])
  @@index([actor_principal_id, occurred_at(sort: Desc)], map: "audit_actor_idx")
  @@index([resource_kind, resource_id, occurred_at(sort: Desc)], map: "audit_resource_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model backpressure_policies {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id            String            @db.Uuid
  level             enforcement_level
  scope_ref         String
  max_concurrency   Int?
  max_rate_per_sec  Decimal?          @db.Decimal(12, 3)
  queue_depth_limit Int?
  on_saturation     saturation_policy
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  orgs              orgs              @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([org_id, level, scope_ref])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model budgets {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id            String            @db.Uuid
  level             enforcement_level
  scope_ref         String
  period            String
  limit_micros      BigInt
  spent_micros      BigInt            @default(0)
  period_started_at DateTime          @default(now()) @db.Timestamptz(6)
  resets_at         DateTime?         @db.Timestamptz(6)
  orgs              orgs              @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([org_id, level, scope_ref, period])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model capability_grants {
  id                                                            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id                                                        String       @db.Uuid
  grant_source                                                  grant_source
  namespace_id                                                  String?      @db.Uuid
  grantee_principal_id                                          String?      @db.Uuid
  resource_kind                                                 String
  resource_id                                                   String       @db.Uuid
  tenant_ref                                                    String?
  constraints                                                   Json         @default("{}")
  granted_by                                                    String       @db.Uuid

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model checkpoints {
  id                                               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id                                           String          @db.Uuid
  step_seq                                         Int
  schema_version                                   Int
  parent_checkpoint_id                             String?         @db.Uuid
  state                                            Json?
  state_artifact_id                                String?         @db.Uuid
  state_hash                                       String
  durability                                       durability_tier
  created_at                                       DateTime        @default(now()) @db.Timestamptz(6)
  checkpoints                                      checkpoints?    @relation("checkpointsTocheckpoints", fields: [parent_checkpoint_id], references: [id], onUpdate: NoAction)
  other_checkpoints                                checkpoints[]   @relation("checkpointsTocheckpoints")
  runs_checkpoints_run_idToruns                    runs            @relation("checkpoints_run_idToruns", fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  artifacts                                        artifacts?      @relation(fields: [state_artifact_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "checkpoints_state_artifact_fk")
  runs_runs_forked_from_checkpoint_idTocheckpoints runs[]          @relation("runs_forked_from_checkpoint_idTocheckpoints")
  runs_runs_last_checkpoint_idTocheckpoints        runs[]          @relation("runs_last_checkpoint_idTocheckpoints")
  steps                                            steps[]

  @@unique([run_id, step_seq, created_at])
  @@index([run_id, step_seq(sort: Desc)], map: "checkpoints_run_idx")
}

model credential_grants {
  id                                                                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id                                                             String             @db.Uuid
  run_id                                                             String             @db.Uuid
  step_id                                                            String?            @db.Uuid
  workload_identity_id                                               String             @db.Uuid
  on_behalf_of_principal_id                                          String?            @db.Uuid
  audience                                                           String
  scopes                                                             String[]
  tenant_ref                                                         String?
  token_id                                                           String             @unique
  issued_at                                                          DateTime           @default(now()) @db.Timestamptz(6)
  expires_at                                                         DateTime           @db.Timestamptz(6)
  revoked_at                                                         DateTime?          @db.Timestamptz(6)
  principals_credential_grants_on_behalf_of_principal_idToprincipals principals?        @relation("credential_grants_on_behalf_of_principal_idToprincipals", fields: [on_behalf_of_principal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orgs                                                               orgs               @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  runs                                                               runs               @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "credential_grants_run_fk")
  principals_credential_grants_workload_identity_idToprincipals      principals         @relation("credential_grants_workload_identity_idToprincipals", fields: [workload_identity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tool_invocations                                                   tool_invocations[]
}

model dead_letters {
  id                                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id                                  String      @db.Uuid
  step_id                                 String?     @db.Uuid
  reason                                  String
  error                                   Json
  attempts                                Int
  last_worker                             String?
  created_at                              DateTime    @default(now()) @db.Timestamptz(6)
  acknowledged_by                         String?     @db.Uuid
  acknowledged_at                         DateTime?   @db.Timestamptz(6)
  replayed_run_id                         String?     @db.Uuid
  principals                              principals? @relation(fields: [acknowledged_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  runs_dead_letters_replayed_run_idToruns runs?       @relation("dead_letters_replayed_run_idToruns", fields: [replayed_run_id], references: [id], onUpdate: NoAction)
  runs_dead_letters_run_idToruns          runs        @relation("dead_letters_run_idToruns", fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  steps                                   steps?      @relation(fields: [step_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "dead_letters_open_idx", where: raw("(acknowledged_at IS NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model deployments {
  id                                                                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id                                                          String          @db.Uuid
  environment                                                       environment
  agent_version_id                                                  String          @db.Uuid
  canary_percent                                                    Int             @default(100) @db.SmallInt
  shadow_from_version_id                                            String?         @db.Uuid
  promotion_eval_run_id                                             String?         @db.Uuid
  state                                                             String          @default("active")
  promoted_by                                                       String?         @db.Uuid
  promoted_at                                                       DateTime?       @db.Timestamptz(6)
  created_at                                                        DateTime        @default(now()) @db.Timestamptz(6)
  gate_overridden_by                                                String?         @db.Uuid
  gate_override_reason                                              String?
  agents                                                            agents          @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agent_versions_deployments_agent_version_idToagent_versions       agent_versions  @relation("deployments_agent_version_idToagent_versions", fields: [agent_version_id], references: [id], onUpdate: NoAction)
  eval_runs                                                         eval_runs?      @relation(fields: [promotion_eval_run_id], references: [id], onUpdate: NoAction, map: "deployments_eval_run_fk")
  principals_deployments_gate_overridden_byToprincipals             principals?     @relation("deployments_gate_overridden_byToprincipals", fields: [gate_overridden_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  principals                                                        principals?     @relation(fields: [promoted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agent_versions_deployments_shadow_from_version_idToagent_versions agent_versions? @relation("deployments_shadow_from_version_idToagent_versions", fields: [shadow_from_version_id], references: [id], onUpdate: NoAction)

  @@unique([agent_id, environment], map: "deployments_active_uq", where: raw("(state = 'active'::text)"))
  @@unique([agent_id, environment, agent_version_id], map: "deployments_live_version_uq", where: raw("(state = ANY (ARRAY['active'::text, 'rolling'::text]))"))
  @@unique([agent_id, environment], map: "deployments_rolling_uq", where: raw("(state = 'rolling'::text)"))
}

model eval_case_results {
  eval_run_id  String     @db.Uuid
  eval_case_id String     @db.Uuid
  run_id       String?    @db.Uuid
  score        Decimal?   @db.Decimal(6, 4)
  passed       Boolean
  detail       Json?
  eval_cases   eval_cases @relation(fields: [eval_case_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  eval_runs    eval_runs  @relation(fields: [eval_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  runs         runs?      @relation(fields: [run_id], references: [id], onUpdate: NoAction)

  @@id([eval_run_id, eval_case_id])
}

model eval_cases {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eval_suite_id     String              @db.Uuid
  name              String
  input             Json
  expectation       Json
  weight            Float               @default(1) @db.Real
  grader            String              @default("contains")
  ab_comparable     Boolean             @default(true)
  eval_case_results eval_case_results[]
  eval_suites       eval_suites         @relation(fields: [eval_suite_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([eval_suite_id, name])
}

model eval_runs {

  expires_at                                                    DateTime?    @db.Timestamptz(6)
  revoked_at                                                    DateTime?    @db.Timestamptz(6)
  principals_capability_grants_granted_byToprincipals           principals   @relation("capability_grants_granted_byToprincipals", fields: [granted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  principals_capability_grants_grantee_principal_idToprincipals principals?  @relation("capability_grants_grantee_principal_idToprincipals", fields: [grantee_principal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  namespaces                                                    namespaces?  @relation(fields: [namespace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orgs                                                          orgs         @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([org_id, resource_kind, resource_id], map: "capability_grants_lookup_idx", where: raw("(revoked_at IS NULL)"))

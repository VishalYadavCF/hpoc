# Copy to .env. Local dev values are the defaults below.

# Postgres — docker-compose maps the container's 5432 to 5440 on the host.
DATABASE_URL="postgresql://hpoc:hpoc@localhost:5440/hpoc?schema=public"

# §5.2 RLS. The role api/worker/scheduler connect as, once migration 0019 has created it.
# Optional: falls back to DATABASE_URL (the owner, which always bypasses RLS) when unset,
# so RLS enforcement is opt-in until this is set deliberately.
APP_DATABASE_URL="postgresql://hpoc_app:hpoc_app@localhost:5440/hpoc?schema=public"

# `prisma migrate dev` creates and drops this database to detect schema drift.
# It is created from template1, which the init script seeds with pgcrypto,
# citext and vector — without that, migrations referencing vector(1536) fail
# against the shadow database only, which is a confusing way to find out.
SHADOW_DATABASE_URL="postgresql://hpoc:hpoc@localhost:5440/hpoc_shadow?schema=public"

# HTTP
PORT=3000
NODE_ENV=development

# §0.4 sandbox. A function tool's body runs inside a container with the interpreter its
# `code_runtime` names; these are the images that provide it. SANDBOX_IMAGE overrides both
# and is the seam for a purpose-built image pinned by digest.
# SANDBOX_IMAGE_NODE="node:22-alpine"
# SANDBOX_IMAGE_PYTHON="python:3.12-alpine"
# SANDBOX_NETWORK="none"          # per-profile egress is still a single global setting

# §11.2 object store. Unset (default) keeps the filesystem adapter, rooted at
# ARTIFACT_ROOT. Uncomment to opt every artifact write into MinIO instead, once
# `docker-compose up -d minio` is running — these match its committed dev credentials.
# MINIO_ENDPOINT="localhost"
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY="hpoc"
# MINIO_SECRET_KEY="hpoc12345"
# MINIO_BUCKET="hpoc-artifacts"

# §15.2 OTLP trace export. Unset means traces stay queryable here and ship nowhere.
# §16.1 Constraint 1 is absolute: the exporter REFUSES any endpoint it cannot establish as
# internal (loopback, private space, or an in-cluster name), so a hosted vendor is not a
# configuration option.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector.observability.svc:4318"
# OTEL_SERVICE_NAME="agent-platform"

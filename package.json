{
  "name": "hpoc",
  "version": "1.0.0",
  "description": "General Agent Platform",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/api/ui/console.html dist/api/ui/console.html",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:up": "docker-compose up -d pg",
    "db:down": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d pg",
    "db:logs": "docker-compose logs -f pg",
    "db:psql": "docker exec -it hpoc-pg psql -U hpoc -d hpoc",
    "minio:up": "docker-compose up -d minio",
    "minio:down": "docker-compose stop minio",
    "minio:reset": "docker-compose rm -sf minio && docker volume rm -f hpoc-miniodata && docker-compose up -d minio",
    "minio:logs": "docker-compose logs -f minio",
    "db:migrate": "node --env-file=.env dist/main.migrate.js",
    "db:verify": "node --env-file=.env db/verify.mjs",
    "db:reference": "bash db/reference.sh",
    "build:core": "tsc -p tsconfig.core.json",
    "start:api": "node --env-file=.env --enable-source-maps dist/main.api.js",
    "start:worker": "node --env-file=.env --enable-source-maps dist/main.worker.js",
    "start:scheduler": "node --env-file=.env --enable-source-maps dist/main.scheduler.js",
    "dev:api": "npm run build && npm run start:api",
    "db:seed": "node --env-file=.env dist/main.seed.js",
    "tool:target": "node scripts/tool-target.mjs",
    "lint:layers": "depcruise src --config .dependency-cruiser.cjs",
    "verify": "npm run lint && npm run build && npm run build:core && npm run typecheck && npm run lint:layers && npm run db:drift && npm run db:types:check && npm run test:replay && npm run test",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "db:seed:gemini": "node --env-file=.env scripts/seed-gemini.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:replay": "vitest run test/replay-corpus.spec.ts",
    "db:drift": "bash db/reference.sh > /dev/null && node db/drift-check.mjs",
    "db:types": "kysely-codegen",
    "db:types:check": "kysely-codegen --verify"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.3",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.5.5",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "deepagents": "^1.11.1",
    "express": "^5.2.1",
    "kysely": "^0.29.5",
    "langchain": "^1.5.4",
    "minio": "^8.0.7",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dependency-cruiser": "^18.2.0",
    "dotenv": "^17.4.2",
    "kysely-codegen": "^0.20.0",
    "oxlint": "^1.58.0",
    "path-to-regexp": "^8.4.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
